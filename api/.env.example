# =============================================================================
# Configuracion de la API de Guarderia
# =============================================================================
#
# Copie este archivo a `.env` y complete los valores. NUNCA versione el `.env`.
#
# Los valores marcados como PENDIENTE no se pueden inventar: son los que cada
# instalacion define. Ver docs/05.

# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------
APP_NAME="Guarderia"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# En produccion tiene que ser false. Con true, un error muestra el archivo y la
# linea donde fallo, y eso puede incluir un dato de un menor.
APP_URL=http://localhost:8080

# Zona horaria del centro. America/Santiago, con horario de verano.
APP_TIMEZONE=America/Santiago

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# DOS ROLES, Y NO UNO. Ver docs/03.
#
# POSTGRES_USER es el ROL DE ARRANQUE del servidor de base de datos. Es el dueño
# inicial del clúster y el que corre las migraciones al crear la base. NO es el
# rol que usa la aplicacion.
#
# DB_USERNAME es `guarderia_app`, un rol sin superusuario que crea el esquema y
# despues se queda con permisos normales. El nombre de `guarderia_app` NO es
# una convencion interna: es el mismo nombre que usa el script
# /docker-entrypoint-initdb.d/10-crear-rol.sh, y los dos tienen que coincidir.
#
# La razon de tenerlos separados es una sola, y es importante: los superusuarios
# SIEMPRE se saltan las politicas de Row Level Security, incluso con
# FORCE ROW LEVEL SECURITY en la tabla. Si la aplicacion corriera con el rol de
# arranque, toda la proteccion entre guarderias seria decorativa.

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=guarderia
DB_USERNAME=guarderia_app
DB_PASSWORD=
DB_SSLMODE=prefer

POSTGRES_DB=guarderia
POSTGRES_USER=guarderia_admin
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Redis: estado de sesion y limitadores
# -----------------------------------------------------------------------------
# El estado de sesion va en Redis y NO en la base. La base es para datos de
# menores; la sesion es del personal.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=database
# `database` y no `file`: una sesion en un archivo dentro del contenedor se
# pierde cuando el contenedor se reinicia, y eso seria cerrar la sesion de una
# educadora a mitad del ingreso de un niño.
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=sync

# -----------------------------------------------------------------------------
# Authentik (OpenID Connect)
# -----------------------------------------------------------------------------
# PENDIENTE: completar con los datos de su instalacion.
#
# AUTHENTIK_ISSUER tiene que ser la URL que el NAVEGADOR puede alcanzar, no el
# nombre de un contenedor de Docker. Es el error de despliegue mas comun de
# esta aplicacion: `http://auth:9000` funciona en el contenedor y no en el
# navegador. Ver docs/04.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8080/api/v1/auth/retorno

AUTHENTIK_ALGORITMO=RS256
# Se deja vacio si no quiere comprobar la audiencia del token.
AUTHENTIK_AUDIENCE=
# Tolerancia de reloj, en segundos.
AUTHENTIK_LEEWAY=60
AUTHENTIK_CACHE_METADATA=60
AUTHENTIK_CACHE_JWKS=1440

# Los equipos SIEMPRE llevan el nombre del producto. Authentik es compartido por
# todas las instalaciones de Hefesto: sin el nombre, una educadora de una
# guarderia seria educadora en todas.
AUTHENTIK_GRUPO_POR_GUARDERIA=Guarderia
AUTHENTIK_PREFIJO_EQUIPO_GUARDERIA=guarderia-
AUTHENTIK_EQUIPO_EDUCADORA=Educadoras de Guarderia
AUTHENTIK_EQUIPO_ADMINISTRATIVO=Administrativos de Guarderia
AUTHENTIK_EQUIPO_DIRECCION=Direccion de Guarderia
AUTHENTIK_CLAIM_GRUPOS=groups

# -----------------------------------------------------------------------------
# Reglas de negocio de Guarderia
# -----------------------------------------------------------------------------
# Con que antelación se avisa que una autorizacion esta por vencer. Es una
# ayuda de operacion, NO un plazo legal: el sistema avisa porque es util, no
# porque se haya verificado que deba.
GUARDERIA_DIAS_AVISO_VENCIMIENTO=15

# Maximo de dias que puede lasting una autorizacion en una sola linea. Ayuda de
# captura, no un limite legal.
GUARDERIA_VIGENCIA_MAXIMA_DIAS=730

# Minutos despues de la jornada para considerar que un nino que no ingreso y
# del que nadie aviso esta en ausencia. Regla de trabajo del centro.
GUARDERIA_MINUTOS_SIN_AVISO=60

# -----------------------------------------------------------------------------
# CONSERVACION: DEJAR EN VACIO
# -----------------------------------------------------------------------------
# NO HAY VALOR POR OMISION, Y NO ES UN OLVIDO.
#
# No se verifico que plazo de conservacion corresponda a la ficha de un menor en
# un centro infantil, ni cuantos anos se guardan los registros de asistencia o de
# retiros. Peor aun: aunque se verificara, no hay un plazo unico que sirva para
# todos los datos de un centro.
#
# Vacio significa "no hay plazo configurado", y el sistema NO borra nada por su
# cuenta. Complete estos valores solo cuando el cliente lo decida, y deje escrito
# de donde salio cada numero. Ver docs/07.
GUARDERIA_RETENCION_FICHAS_MEDICAS_DIAS=
GUARDERIA_RETENCION_ASISTENCIAS_DIAS=
GUARDERIA_RETENCION_RETIROS_DIAS=
GUARDERIA_RETENCION_ACCESOS_DIAS=
GUARDERIA_AVISAR_ANTES_DE_PURGAR=false

# -----------------------------------------------------------------------------
# Correo
# -----------------------------------------------------------------------------
# PENDIENTE: en esta version NO hay correo saliente implementado. El Job de
# aviso de vencimientos escribe en el registro del servidor, no en el correo.
# Configurar el correo no habilita el envio: eso hay que escribirlo. Ver docs/10.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Guarderia"

# -----------------------------------------------------------------------------
# Depuracion
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Pruebas
# -----------------------------------------------------------------------------
# La base de pruebas usa las MISMAS politicas de Row Level Security que la de
# produccion. Una prueba que corre contra una base sin RLS no prueba el
# aislamiento: prueba que hay una columna `tenant_id`. Ver docs/10.
DB_TEST_DATABASE=guarderia_pruebas