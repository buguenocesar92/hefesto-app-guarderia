# Configuración de la interfaz de Guardería.
#
# Copie este archivo a `.env` y complete los valores. NUNCA versione el `.env`.

# -----------------------------------------------------------------------------
# La dirección de la API
# -----------------------------------------------------------------------------
# NUXT_API_INTERNA la usa SÓLO el servidor de Nuxt. El navegador nunca la ve.
#
# PENDIENTE: en desarrollo suele ser `http://localhost:8000`; en producción es el
# nombre del servicio dentro de la red de Docker. No se verificó cuál corresponde
# a esta instalación: depende del despliegue. Ver docs/04.
NUXT_API_INTERNA=http://localhost:8000

# -----------------------------------------------------------------------------
# Lo que sí llega al navegador
# -----------------------------------------------------------------------------
# Sólo el nombre. Cualquier otra cosa que se agregue aquí queda expuesta en el
# código del navegador, y en esta aplicación eso no incluye datos de menores.
NUXT_PUBLIC_NOMBRE=Guardería

# -----------------------------------------------------------------------------
# Puerto del servidor de la interfaz
# -----------------------------------------------------------------------------
NUXT_PORT=3000
NUXT_HOST=0.0.0.0